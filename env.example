NEXT_PUBLIC_SITE_URL=https://appomatrix.com

# Custom admin (required for /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

RESEND_API_KEY=
RESEND_FROM_EMAIL=Appo Matrix <hello@appomatrix.com>
CONTACT_NOTIFY_EMAIL=hello@appomatrix.com

# Contact page inline calendar (https://calendly.com/your-team/meeting-type)
