DirectoryIndex index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host (works once DNS points to this server).
  RewriteCond %{HTTP_HOST} ^appomatrix\.com$ [NC]
  RewriteRule ^ https://www.appomatrix.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^data/ - [F,L]
  RewriteRule ^lib/ - [F,L]
  RewriteRule ^templates/ - [F,L]
  RewriteRule ^drizzle/ - [F,L]
  RewriteRule ^admin/.+\.php$ - [F,L]

  # Physical admin/ folder exists — route CMS URLs through index.php (avoid 403 with -Indexes).
  RewriteRule ^admin(/.*)?$ index.php [L,QSA]

  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L,QSA]
</IfModule>
