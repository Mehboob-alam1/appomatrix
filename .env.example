# Copy to .env and fill in the Hostinger MySQL database from hPanel.
# Never commit .env. The database must already exist.

DB_HOST=localhost
DB_PORT=3306
DB_USER=u276950232_appomatrix
DB_PASSWORD=your_mysql_password
DB_NAME=u276950232_appomatrix
# Set to true if Hostinger remote MySQL requires TLS.
DB_SSL=false

# Random string, at least 32 characters. Required in production.
AUTH_SECRET=replace-with-a-long-random-string

# Used only when the users table is empty on first boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-boot

# Public site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Persistent upload directory. On Hostinger, point this outside the deploy folder
# so a rebuild does not delete images. Leave blank to use data/uploads.
UPLOAD_DIR=

# Outbound email (Hostinger / any SMTP). Required for admin inbox replies.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=hello@appomatrix.com
# SMTP_PASS=your_mailbox_password
# SMTP_FROM=hello@appomatrix.com
# Where new contact-form inquiries are emailed (defaults to settings.email / SMTP_FROM).
# SMTP_NOTIFY_TO=hello@appomatrix.com

# Optional IMAP sync so external client emails appear in /admin/inbox.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=hello@appomatrix.com
# IMAP_PASS=your_mailbox_password
